# ZPMeow WhatsApp API - Environment Configuration Example
# Copy this file to .env and update the values according to your environment

# =============================================================================
# 🗄️ DATABASE CONFIGURATION
# =============================================================================
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=zpmeow
DB_SSLMODE=disable

# =============================================================================
# 🚀 SERVER CONFIGURATION
# =============================================================================
SERVER_PORT=8080
GIN_MODE=debug

# =============================================================================
# 🔐 AUTHENTICATION
# =============================================================================
# Global API Key for accessing all sessions and session management
GLOBAL_API_KEY=your-super-secret-global-api-key-here

# =============================================================================
# 📝 LOGGING CONFIGURATION
# =============================================================================
# Log level: debug, info, warn, error, fatal, panic
LOG_LEVEL=info

# Log format: console, json
LOG_FORMAT=console

# Console logging with colors (true/false)
LOG_CONSOLE_COLOR=true

# File logging configuration
LOG_FILE_ENABLED=true
LOG_FILE_PATH=log/app.log
LOG_FILE_FORMAT=json

# Log rotation settings
LOG_FILE_MAX_SIZE=100
LOG_FILE_MAX_BACKUPS=3
LOG_FILE_MAX_AGE=28
LOG_FILE_COMPRESS=true

# =============================================================================
# 🐳 DOCKER SERVICES (for docker-compose)
# =============================================================================
# MinIO Configuration (Object Storage)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123

# =============================================================================
# 📝 CONFIGURATION NOTES
# =============================================================================
# 
# 🔧 Development Setup:
# 1. Copy this file: cp .env.example .env
# 2. Update the values according to your environment
# 3. Run: make up (to start services with Docker)
# 4. Run: make run (to start the application)
#
# 🗄️ Database:
# - PostgreSQL is used as the main database
# - Migrations are automatically run on startup
# - DBGate is available at http://localhost:3000 for database management
#
# 🔐 Authentication:
# - GLOBAL_API_KEY: Can access all sessions and session management
# - Session-specific API keys are managed through the API
#
# 📝 Logging:
# - Console logs are colored by default in development
# - File logs are saved in JSON format for better parsing
# - Log rotation prevents disk space issues
#
# 🐳 Docker Services:
# - PostgreSQL: Database (port 5432)
# - Redis: Caching (port 6379)
# - MinIO: Object storage (port 9000, console 9001)
# - DBGate: Database management UI (port 3000)
#
# 🚀 Production Notes:
# - Set GIN_MODE=release for production
# - Use strong passwords and API keys
# - Enable SSL/TLS (set DB_SSLMODE=require)
# - Consider using environment-specific .env files
# - Monitor log file sizes and rotation
#
# 📱 WhatsApp Integration:
# - Session data is stored in the database
# - QR codes are generated for new sessions
# - Multiple sessions can be managed simultaneously
#
# =============================================================================
